# Caddy for flowmedium.pro: certificates, HTTP/2 and HTTP/3 come by themselves.
# Put the contents of dist/ into /var/www/flowmedium and run `caddy run --config Caddyfile` (or use it as /etc/caddy/Caddyfile).
www.flowmedium.pro {
  redir https://flowmedium.pro{uri} permanent
}

flowmedium.pro {
  root * /var/www/flowmedium
  encode zstd br gzip
  file_server {
    precompressed br gzip
  }
  redir /soglasie_cookie /cookie_consent permanent         # the old address of the cookie consent (Tilda's)
  try_files {path} {path}.html {path}/
  handle_errors {
    @404 expression {err.status_code} == 404
    rewrite @404 /404.html
    file_server
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Content-Security-Policy "frame-ancestors 'self'"
    Cross-Origin-Opener-Policy "same-origin"
    Cache-Control "no-cache"
    -Server
  }
  # files whose name carries a hash of their content: cached for a year
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"
}
