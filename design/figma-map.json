  "modes": {
    "$about": "Which screen widths each mode of a multi-mode collection stands for. The base mode goes in :root; each layer overrides it inside a media condition (a custom media of src/styles/base/media.css, or the condition itself), where it differs from the mode in effect around it (parent).",
    "Breakpoint": {
      "base": "1024",
      "renamed": {
        "480": "390"
      },
      "layers": [
        {
          "mode": "1440",
          "media": "width >= 90em",
          "parent": "1024"
        },
        {
          "mode": "1920",
          "media": "width >= 120em",
          "parent": "1440"
        },
        {
          "mode": "768",
          "media": "--tablet",
          "parent": "1024"
        },
        {
          "mode": "390",
          "media": "--phone",
          "parent": "768"
        },
        {
          "mode": "320",
          "media": "width < 24.375em",
          "parent": "390"
        }
      ]
    }
  },
  "sections": {
